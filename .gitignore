# Build artifacts
build/
dist/
frontend/dist/

# Dependencies
node_modules/

# OS / editor
Thumbs.db
Desktop.ini
.vscode/
.idea/

# Local user data (never commit)
*.db
*.db-wal
*.db-shm

# Workspace memory / agent data (never commit)
.workbuddy/

# Test temp tree (see testmain_test.go::testTempParent). It normally lives
# beside the project, not inside it, so these are a safety net in case the
# location is ever moved back.
.tmp-test/
tmp-test/

# Compiled binaries (except intended release artifacts)
*.exe
!build/bin/*.exe

# Wails build resource artifacts
*.syso
